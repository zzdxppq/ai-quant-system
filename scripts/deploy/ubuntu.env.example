# 复制到服务器项目根目录: cp scripts/deploy/ubuntu.env.example .env
# DuckDB 库文件首次启动时自动创建: data/quant.duckdb

API_HOST=0.0.0.0
API_PORT=8001

# 业务数据仅走 DuckDB（与 config.py 一致，勿改）
DATA_STORAGE_BACKEND=quant

# 启动时不拉 akshare 全市场（避免首屏并发拖垮进程）
STOCK_BASIC_STARTUP_SYNC=0
STARTUP_ADVICE_REFRESH=0

# 降低 numpy/BLAS 多线程与 API 并发叠加风险
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
TQDM_DISABLE=1

# 邮件（按需填写）
# SMTP_USER=
# SMTP_PASSWORD=
